{
    "name": "@core-ai/google-vertex",
    "version": "0.21.1",
    "description": "Vertex AI Google provider package for @core-ai/core-ai",
    "license": "MIT",
    "author": "Omnifact (https://omnifact.ai)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/agdevhq/core-ai.git",
        "directory": "packages/google-vertex"
    },
    "keywords": [
        "llm",
        "ai",
        "google",
        "gemini",
        "imagen",
        "vertex",
        "vertex-ai",
        "google-cloud",
        "provider",
        "sdk"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint src/ --max-warnings 0",
        "check-types": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@core-ai/core-ai": "^0.21.1",
        "@core-ai/google-genai": "^0.21.1",
        "@google/genai": "^1.42.0"
    },
    "peerDependencies": {
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@core-ai/eslint-config": "*",
        "@core-ai/typescript-config": "*",
        "typescript": "^5.7.3",
        "vitest": "^3.2.4"
    }
}
