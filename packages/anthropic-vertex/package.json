{
    "name": "@core-ai/anthropic-vertex",
    "version": "0.20.0",
    "description": "Vertex AI Anthropic (Claude) provider package for @core-ai/core-ai",
    "license": "MIT",
    "author": "Omnifact (https://omnifact.ai)",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/agdevhq/core-ai.git",
        "directory": "packages/anthropic-vertex"
    },
    "keywords": [
        "llm",
        "ai",
        "anthropic",
        "claude",
        "vertex",
        "vertex-ai",
        "google-cloud",
        "provider",
        "sdk"
    ],
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "require": "./dist/index.js",
            "default": "./dist/index.js"
        }
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "build": "tsup",
        "lint": "eslint src/ --max-warnings 0",
        "check-types": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "dependencies": {
        "@anthropic-ai/vertex-sdk": "^0.19.0",
        "@core-ai/anthropic": "^0.20.0",
        "@core-ai/core-ai": "^0.20.0",
        "google-auth-library": "^10.2.0"
    },
    "peerDependencies": {
        "zod": "^4.0.0"
    },
    "devDependencies": {
        "@core-ai/eslint-config": "*",
        "@core-ai/testing": "*",
        "@core-ai/typescript-config": "*",
        "typescript": "^5.7.3",
        "vitest": "^3.2.4"
    }
}
